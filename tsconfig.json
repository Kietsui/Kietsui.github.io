{
  "compilerOptions": {
    "target": "es6",               // modern JS version
    "module": "es2020",            // module system for browsers
    "lib": ["dom", "es6"],         // include DOM & ES6 libs (needed for Promise, find, etc.)
    "moduleResolution": "node",
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "outDir": "./dist",            // output folder for JS files
    "skipLibCheck": true
  },
  "include": ["onepiecedle/game.ts"]
}
